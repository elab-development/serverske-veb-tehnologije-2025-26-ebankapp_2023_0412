{
    "openapi": "3.0.0",
    "info": {
        "title": "E-bankarstvo API",
        "description": "REST API za e-bankarsku aplikaciju - upravljanje računima, transakcijama i deviznim kursevima.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Lokalni server"
        }
    ],
    "paths": {
        "/api/transfer": {
            "post": {
                "tags": [
                    "Transakcije"
                ],
                "summary": "Prenos sredstava sa konverzijom valuta",
                "description": "Vrši prenos sredstava sa jednog računa na drugi, uz automatsku konverziju ako su valute različite.",
                "operationId": "ff447720cf8647ed4d7a3854209f0b69",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "sender_account_id",
                                    "receiver_account_id",
                                    "amount"
                                ],
                                "properties": {
                                    "sender_account_id": {
                                        "type": "string",
                                        "example": "019f2265-17dd-7344-9523-49b5a81c64e1"
                                    },
                                    "receiver_account_id": {
                                        "type": "string",
                                        "example": "019f2265-17f6-7067-8722-cfdbf5809e6d"
                                    },
                                    "amount": {
                                        "type": "number",
                                        "example": 50
                                    },
                                    "category": {
                                        "type": "string",
                                        "example": "Hrana"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "test kupovina"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Prenos uspešno izvršen"
                    },
                    "400": {
                        "description": "Nedovoljno sredstava ili nevažeći podaci"
                    },
                    "403": {
                        "description": "Nemate pristup ovom računu"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Transakcije",
            "description": "Transakcije"
        }
    ]
}